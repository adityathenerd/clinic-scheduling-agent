# Copy this file to .env and add local values. The CLI automatically loads the
# project-root .env file. Existing process variables take precedence.
# Never commit live credentials; .env is ignored by git.
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_BASE_URL=
# Destination for the bounded patient-001 demo record. On Twilio Trial this
# must be a verified Caller ID. Never use a real patient's number in the demo.
DEMO_PATIENT_PHONE_E164=
# Synthetic acceptance calls only. Leave disabled for real patient data.
VOICE_LOG_TRANSCRIPTS=0
